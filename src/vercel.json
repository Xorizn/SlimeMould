{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "scripts/pathfinder.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/path",
      "dest": "/scripts/pathfinder.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
