{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "scripts/pathfinder.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/pathfinder",
      "dest": "/scripts/pathfinder.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
